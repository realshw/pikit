{
  "name": "pikit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A bundle of pi extensions and skills, installed together.",
  "keywords": [
    "pi-package",
    "pi",
    "extensions"
  ],
  "license": "0BSD",
  "author": "Shengyun Wang <leo_wsy@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realshw/pikit.git"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.1",
    "@types/node": "^26.4.0",
    "prettier": "^3.9.8",
    "typebox": "^1.3.30",
    "typescript": "^5.9.3"
  }
}
